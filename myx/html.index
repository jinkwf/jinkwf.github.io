<script>

/* ─────────────────────────────
   INTRO
───────────────────────────── */

function enterSite(){

  const intro =
    document.getElementById("intro");

  const main =
    document.getElementById("main");

  intro.classList.add("hide");

  main.classList.add("show");

  setTimeout(function(){

    intro.style.display="none";

    refreshReveal();

  },950);

}


/* Enter / Space */

document
  .getElementById("intro")
  .addEventListener("keydown",function(e){

    if(
      e.key==="Enter" ||
      e.key===" "
    ){
      enterSite();
    }

  });


/* ─────────────────────────────
   CHARACTER TAB
───────────────────────────── */

function showCharacter(id,button){

  const panels =
    document.querySelectorAll(
      ".character-panel"
    );

  const tabs =
    document.querySelectorAll(
      ".char-tab"
    );

  panels.forEach(function(panel){

    panel.classList.remove("active");

  });

  tabs.forEach(function(tab){

    tab.classList.remove("active");

  });


  const selected =
    document.getElementById(id);

  selected.classList.add("active");

  button.classList.add("active");


  /* 탭을 누르면 캐릭터 영역 상단으로 */

  const tabArea =
    document.querySelector(
      ".character-tabs"
    );

  const offset =
    window.innerWidth <= 760
      ? 105
      : 120;

  window.scrollTo({
    top:
      tabArea.getBoundingClientRect().top
      + window.scrollY
      - offset,

    behavior:"smooth"
  });


  /* 새 캐릭터 reveal 초기화 */

  selected
    .querySelectorAll(".reveal")
    .forEach(function(item){

      item.classList.remove("visible");

    });


  setTimeout(function(){

    refreshReveal();

  },450);

}


/* ─────────────────────────────
   SCROLL REVEAL
───────────────────────────── */

const observerOptions = {

  root:null,

  rootMargin:
    "0px 0px -12% 0px",

  threshold:.08

};


const revealObserver =
  new IntersectionObserver(
    function(entries){

      entries.forEach(
        function(entry){

          if(entry.isIntersecting){

            entry.target
              .classList
              .add("visible");

          }

        }
      );

    },
    observerOptions
  );


function observeReveal(){

  document
    .querySelectorAll(".reveal")
    .forEach(function(item){

      revealObserver.observe(item);

    });

}


function refreshReveal(){

  document
    .querySelectorAll(
      ".character-panel.active .reveal, .world-section .reveal"
    )
    .forEach(function(item){

      const rect =
        item.getBoundingClientRect();

      if(
        rect.top <
        window.innerHeight * .88
      ){

        item.classList.add("visible");

      }

    });

}


/* 실행 */

observeReveal();

window.addEventListener(
  "scroll",
  refreshReveal,
  {passive:true}
);

window.addEventListener(
  "resize",
  refreshReveal
);

</script>

</body>
</html>
