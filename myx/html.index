<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#050505">

<title>나의 X</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

:root{
  --black:#040404;
  --black2:#080808;
  --panel:#0d0d0e;
  --panel2:#111112;
  --white:#eeeeef;
  --gray:#8b8b8f;
  --gray2:#5b5b60;
  --gray3:#333337;
  --line:#202023;
  --red:#a20f1c;
  --red2:#d11b2c;
}

/* ─────────────────────────────
   BASE
───────────────────────────── */

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  background:var(--black);
  color:var(--white);
  font-family:"Noto Sans KR",sans-serif;
  word-break:keep-all;
  overflow-x:hidden;
}

button{
  font:inherit;
}

::selection{
  background:var(--red);
  color:#fff;
}

/* ─────────────────────────────
   INTRO
───────────────────────────── */

#intro{
  position:fixed;
  inset:0;
  z-index:9999;

  display:flex;
  align-items:center;
  justify-content:center;

  background:#020202;
  cursor:pointer;

  overflow:hidden;

  transition:
    opacity .9s ease,
    visibility .9s ease;
}

#intro.hide{
  opacity:0;
  visibility:hidden;
  pointer-events:none;
}

.intro-bg{
  position:absolute;
  inset:-30px;

  display:grid;
  grid-template-columns:repeat(3,1fr);

  opacity:.12;

  filter:
    grayscale(1)
    contrast(1.22);
}

.intro-bg-item{
  position:relative;
  background-size:cover;
  background-position:center top;
}

.intro-bg-item::after{
  content:"";
  position:absolute;
  inset:0;

  background:
    linear-gradient(
      to bottom,
      rgba(0,0,0,.32),
      rgba(0,0,0,.86)
    );
}

.intro-vignette{
  position:absolute;
  inset:0;

  background:
    radial-gradient(
      circle at center,
      transparent 0%,
      rgba(0,0,0,.22) 30%,
      rgba(0,0,0,.75) 80%,
      #010101 100%
    );
}

.intro-noise{
  position:absolute;
  inset:0;
  pointer-events:none;

  opacity:.035;

  background-image:
    url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='.8'/%3E%3C/svg%3E");
}

.intro-content{
  position:relative;
  z-index:2;

  text-align:center;
}

.intro-caption{
  margin-bottom:22px;

  color:#777;

  font-size:8px;
  letter-spacing:.55em;
}

.intro-title{
  margin:0;

  font-family:"Cormorant Garamond","Noto Sans KR",serif;

  font-size:clamp(64px,14vw,140px);
  line-height:.78;

  font-weight:400;
  letter-spacing:-.07em;
}

.intro-x{
  display:inline-block;

  color:var(--red2);

  font-size:1.22em;
  font-style:italic;

  text-shadow:
    0 0 25px rgba(209,27,44,.22);

  animation:xShake 4.2s infinite;
}

@keyframes xShake{

  0%,
  83%,
  100%{
    transform:translate(0,0) rotate(-5deg);
  }

  84%{
    transform:translate(-2px,1px) rotate(-7deg);
  }

  85%{
    transform:translate(4px,-1px) rotate(-2deg);
  }

  86%{
    transform:translate(-3px,2px) rotate(-6deg);
  }

  87%{
    transform:translate(2px,-2px) rotate(-4deg);
  }

  89%{
    transform:translate(0,0) rotate(-5deg);
  }

}

.intro-line{
  width:1px;
  height:45px;

  margin:34px auto 22px;

  background:
    linear-gradient(
      transparent,
      #777,
      transparent
    );
}

.intro-enter{
  color:#777;

  font-size:8px;
  letter-spacing:.42em;

  animation:enterBlink 2.4s infinite;
}

@keyframes enterBlink{

  0%,100%{
    opacity:.3;
  }

  50%{
    opacity:1;
  }

}

/* ─────────────────────────────
   MAIN
───────────────────────────── */

main{
  opacity:0;
  transform:translateY(12px);

  transition:
    opacity 1s ease .15s,
    transform 1s ease .15s;
}

main.show{
  opacity:1;
  transform:none;
}

.wrap{
  width:min(1180px,calc(100% - 40px));
  margin:auto;
}

/* ─────────────────────────────
   NAV
───────────────────────────── */

nav{
  position:sticky;
  top:0;

  z-index:100;

  border-bottom:1px solid rgba(255,255,255,.06);

  backdrop-filter:blur(18px);

  background:
    rgba(4,4,4,.82);
}

.nav-inner{
  width:min(1180px,calc(100% - 40px));

  height:64px;

  margin:auto;

  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-family:"Cormorant Garamond",serif;

  font-size:24px;
  letter-spacing:-.04em;
}

.logo b{
  color:var(--red2);

  font-size:31px;
  font-weight:400;
  font-style:italic;
}

.nav-right{
  color:#555;

  font-size:8px;
  letter-spacing:.3em;
}

/* ─────────────────────────────
   HERO
───────────────────────────── */

.hero{
  position:relative;

  min-height:610px;
  height:82vh;
  max-height:850px;

  display:flex;
  align-items:center;

  overflow:hidden;

  border-bottom:1px solid var(--line);
}

.hero-bg{
  position:absolute;

  top:0;
  right:0;

  width:67%;
  height:100%;

  opacity:.22;

  filter:
    grayscale(1)
    contrast(1.1);

  background:
    linear-gradient(
      90deg,
      #040404 0%,
      rgba(4,4,4,.72) 22%,
      transparent 65%
    ),
    linear-gradient(
      0deg,
      #040404 0%,
      transparent 45%
    ),
    url("https://github.com/jinkwf/jinkwf.github.io/blob/main/imgflll/Adobe%20Express%202026-07-24%2017.14.17.gif?raw=true")
    center top / cover no-repeat;
}

.hero-content{
  position:relative;
  z-index:2;

  max-width:600px;
}

.eyebrow{
  margin-bottom:25px;

  color:var(--red2);

  font-size:8px;
  font-weight:600;
  letter-spacing:.46em;
}

.hero-title{
  margin:0;

  font-family:"Cormorant Garamond","Noto Sans KR",serif;

  font-size:clamp(70px,11vw,130px);
  font-weight:400;

  line-height:.8;
  letter-spacing:-.075em;
}

.hero-title i{
  color:var(--red2);
  font-weight:400;
}

.hero-desc{
  margin-top:36px;

  max-width:450px;

  color:#777;

  font-size:11px;
  line-height:2.1;
}

.scroll-guide{
  margin-top:55px;

  display:flex;
  align-items:center;
  gap:15px;

  color:#505054;

  font-size:8px;
  letter-spacing:.32em;
}

.scroll-guide::before{
  content:"";

  display:block;

  width:42px;
  height:1px;

  background:#505054;
}

/* ─────────────────────────────
   CHARACTER NAV
───────────────────────────── */

.character-section{
  padding:95px 0 0;
}

.section-heading{
  margin-bottom:35px;

  display:flex;
  align-items:flex-end;
  justify-content:space-between;

  border-bottom:1px solid var(--line);

  padding-bottom:25px;
}

.section-no{
  color:var(--red2);

  font-family:"Cormorant Garamond",serif;

  font-size:15px;
  font-style:italic;
}

.section-heading h2{
  margin:5px 0 0;

  font-family:"Cormorant Garamond","Noto Sans KR",serif;

  font-size:clamp(42px,6vw,62px);
  font-weight:400;
  letter-spacing:-.05em;
}

.section-sub{
  color:#535357;

  font-size:8px;
  letter-spacing:.25em;
}

.character-tabs{
  position:sticky;
  top:64px;

  z-index:80;

  display:flex;

  background:
    rgba(4,4,4,.94);

  backdrop-filter:blur(16px);

  border-bottom:1px solid var(--line);
}

.char-tab{
  flex:1;

  min-width:110px;

  padding:20px 15px;

  border:0;
  border-bottom:1px solid transparent;

  background:transparent;

  color:#5d5d61;

  cursor:pointer;

  font-size:11px;
  letter-spacing:.18em;

  transition:.3s ease;
}

.char-tab:hover{
  color:#aaa;
}

.char-tab.active{
  color:#fff;
  border-bottom-color:var(--red2);
}

/* ─────────────────────────────
   CHARACTER PANEL
───────────────────────────── */

.character-panel{
  display:none;

  padding:55px 0 140px;
}

.character-panel.active{
  display:block;

  animation:panelFade .65s ease;
}

@keyframes panelFade{

  from{
    opacity:0;
  }

  to{
    opacity:1;
  }

}

.character-layout{
  display:grid;

  grid-template-columns:
    minmax(300px,.86fr)
    minmax(380px,1.14fr);

  gap:70px;

  align-items:start;
}

/* LEFT IMAGE */

.character-left{
  position:sticky;

  top:160px;

  height:
    calc(100vh - 190px);

  min-height:520px;
  max-height:760px;
}

.portrait{
  position:relative;

  width:100%;
  height:100%;

  overflow:hidden;

  background:#080808;

  border:1px solid var(--line);
}

.portrait img{
  position:absolute;
  inset:0;

  width:100%;
  height:100%;

  object-fit:cover;
  object-position:center top;

  filter:
    grayscale(1)
    contrast(1.06)
    brightness(.82);

  transition:
    transform 1s ease,
    filter 1s ease;
}

.portrait:hover img{
  transform:scale(1.025);

  filter:
    grayscale(.8)
    contrast(1.04)
    brightness(.88);
}

.portrait-overlay{
  position:absolute;
  inset:0;

  pointer-events:none;

  background:
    linear-gradient(
      to bottom,
      transparent 55%,
      rgba(0,0,0,.83) 100%
    );
}

.portrait-index{
  position:absolute;

  left:27px;
  bottom:26px;

  z-index:2;
}

.portrait-index small{
  display:block;

  margin-bottom:5px;

  color:var(--red2);

  font-family:"Cormorant Garamond",serif;
  font-style:italic;

  font-size:12px;
}

.portrait-index strong{
  display:block;

  font-size:12px;
  font-weight:400;
  letter-spacing:.18em;
}

/* RIGHT TEXT */

.character-right{
  padding-top:10px;
}

.story-block{
  margin-bottom:115px;
}

.story-block:last-child{
  margin-bottom:20px;
}

/* SCROLL REVEAL */

.reveal{
  opacity:0;

  transform:translateY(28px);

  filter:blur(3px);

  transition:
    opacity .85s cubic-bezier(.2,.7,.2,1),
    transform .85s cubic-bezier(.2,.7,.2,1),
    filter .85s ease;
}

.reveal.visible{
  opacity:1;

  transform:translateY(0);

  filter:blur(0);
}

.reveal.delay-1{
  transition-delay:.05s;
}

.reveal.delay-2{
  transition-delay:.12s;
}

.reveal.delay-3{
  transition-delay:.18s;
}

/* QUOTE */

.main-quote{
  position:relative;

  margin:0;

  padding-left:28px;

  font-family:"Cormorant Garamond","Noto Sans KR",serif;

  font-size:clamp(23px,3.1vw,35px);
  line-height:1.65;

  font-weight:400;
  font-style:italic;

  color:#e4e4e5;
}

.main-quote::before{
  content:"";

  position:absolute;

  left:0;
  top:8px;

  width:2px;
  height:70px;

  background:var(--red2);
}

.scene-desc{
  margin-top:34px;

  color:#777;

  font-size:11px;
  line-height:2.15;
}

.scene-dialogue{
  margin-top:25px;

  color:#aaa;

  font-family:"Cormorant Garamond","Noto Sans KR",serif;

  font-size:17px;
  font-style:italic;
}

/* BLOCK HEADER */

.block-header{
  margin-bottom:32px;

  display:flex;
  align-items:center;
  gap:13px;
}

.block-number{
  color:var(--red2);

  font-family:"Cormorant Garamond",serif;

  font-size:12px;
  font-style:italic;
}

.block-header h3{
  margin:0;

  font-size:12px;
  font-weight:500;

  letter-spacing:.18em;
}

.block-line{
  flex:1;

  height:1px;

  background:var(--line);
}

/* PROFILE */

.profile-name{
  margin-bottom:32px;

  font-size:clamp(36px,5vw,55px);

  font-weight:300;

  letter-spacing:-.06em;
}

.profile-list{
  border-top:1px solid var(--line);
}

.profile-row{
  display:grid;

  grid-template-columns:120px 1fr;

  gap:25px;

  padding:15px 0;

  border-bottom:1px solid var(--line);

  font-size:11px;
  line-height:1.8;
}

.profile-row span:first-child{
  color:#555;
}

.profile-row span:last-child{
  color:#aaa;
}

.profile-note{
  margin-top:28px;

  color:#68686c;

  font-size:10px;
  line-height:2;
}

/* PEOPLE */

.people-list{
  border-top:1px solid var(--line);
}

.person-row{
  padding:20px 0;

  border-bottom:1px solid var(--line);
}

.person-name{
  margin-bottom:6px;

  color:#c9c9cb;

  font-size:11px;
  font-weight:500;
}

.person-desc{
  color:#606064;

  font-size:10px;
  line-height:1.9;
}

/* COMMAND */

.command-list{
  display:grid;

  gap:10px;
}

.command{
  position:relative;

  padding:18px 20px 18px 24px;

  background:#0b0b0c;

  border:1px solid #1c1c1f;

  transition:.3s ease;
}

.command::before{
  content:"";

  position:absolute;

  left:0;
  top:0;
  bottom:0;

  width:2px;

  background:#28282c;

  transition:.3s ease;
}

.command:hover{
  transform:translateX(4px);

  background:#101011;

  border-color:#303034;
}

.command:hover::before{
  background:var(--red2);
}

.command-name{
  margin-bottom:6px;

  color:#d9d9da;

  font-size:11px;
  font-weight:600;

  letter-spacing:.06em;
}

.command-desc{
  color:#626267;

  font-size:9px;
  line-height:1.8;
}

/* CHARACTER END */

.character-end{
  padding-top:60px;

  text-align:center;

  color:#333337;
}

.character-end .end-x{
  font-family:"Cormorant Garamond",serif;

  color:var(--red);

  font-size:48px;
  font-style:italic;
}

.character-end span{
  display:block;

  margin-top:-8px;

  font-size:7px;
  letter-spacing:.4em;
}

/* ─────────────────────────────
   WORLD
───────────────────────────── */

.world-section{
  padding:110px 0;

  background:#070707;

  border-top:1px solid var(--line);
}

.world-grid{
  display:grid;
  gap:12px;
}

.world-card{
  padding:38px 40px;

  background:#0d0d0e;

  border:1px solid var(--line);

  transition:.35s ease;
}

.world-card:hover{
  background:#111112;

  border-color:#303034;

  transform:translateX(4px);
}

.world-head{
  display:flex;

  align-items:center;
  justify-content:space-between;

  gap:20px;
}

.world-name{
  font-size:19px;
}

.world-eng{
  color:var(--red2);

  font-family:"Cormorant Garamond",serif;

  font-size:11px;
  letter-spacing:.2em;
}

.world-desc{
  max-width:800px;

  margin:17px 0 25px;

  color:#66666a;

  font-size:10px;
  line-height:2;
}

.world-person-list{
  border-top:1px solid var(--line);
}

.world-person{
  display:grid;

  grid-template-columns:120px 1fr;

  gap:20px;

  padding:13px 0;

  border-bottom:1px solid #1c1c1f;

  font-size:10px;
  line-height:1.8;
}

.world-person strong{
  color:#b5b5b7;

  font-weight:500;
}

.world-person span{
  color:#5f5f63;
}

/* ─────────────────────────────
   FOOTER
───────────────────────────── */

footer{
  padding:100px 20px 75px;

  text-align:center;

  border-top:1px solid var(--line);
}

.footer-x{
  color:var(--red2);

  font-family:"Cormorant Garamond",serif;

  font-size:58px;
  font-style:italic;
}

.footer-title{
  margin-top:-10px;

  color:#777;

  font-size:9px;
  letter-spacing:.35em;
}

.footer-copy{
  margin-top:32px;

  color:#343438;

  font-size:7px;
  letter-spacing:.18em;
}

/* ─────────────────────────────
   MOBILE
───────────────────────────── */

@media(max-width:760px){

  .wrap{
    width:min(100% - 28px,1180px);
  }

  .nav-inner{
    width:min(100% - 28px,1180px);
    height:57px;
  }

  .hero{
    min-height:630px;
    height:88vh;
  }

  .hero-bg{
    width:100%;

    opacity:.2;

    background:
      linear-gradient(
        0deg,
        #040404 0%,
        rgba(4,4,4,.5) 65%,
        rgba(4,4,4,.2)
      ),
      url("https://github.com/jinkwf/jinkwf.github.io/blob/main/imgflll/Adobe%20Express%202026-07-24%2017.14.17.gif?raw=true")
      68% top / cover no-repeat;
  }

  .hero-content{
    align-self:flex-end;

    padding-bottom:70px;
  }

  .character-section{
    padding-top:75px;
  }

  .section-heading{
    align-items:flex-start;
    flex-direction:column;
  }

  .section-sub{
    margin-top:12px;
  }

  .character-tabs{
    top:57px;

    overflow-x:auto;

    scrollbar-width:none;
  }

  .character-tabs::-webkit-scrollbar{
    display:none;
  }

  .character-layout{
    display:block;
  }

  .character-left{
    position:relative;

    top:auto;

    height:68vh;
    min-height:480px;
    max-height:650px;

    margin-bottom:65px;
  }

  .character-right{
    padding:0 4px;
  }

  .story-block{
    margin-bottom:90px;
  }

  .main-quote{
    padding-left:22px;

    font-size:24px;
  }

  .profile-row{
    grid-template-columns:90px 1fr;
    gap:18px;
  }

  .world-card{
    padding:28px 23px;
  }

  .world-head{
    display:block;
  }

  .world-eng{
    margin-top:8px;
  }

  .world-person{
    grid-template-columns:90px 1fr;
  }

  .intro-bg{
    grid-template-columns:1fr;
  }

  .intro-bg-item:not(:nth-child(2)){
    display:none;
  }

}

/* 모션 감소 설정 */

@media(prefers-reduced-motion:reduce){

  *,
  *::before,
  *::after{
    animation-duration:.01ms!important;
    animation-iteration-count:1!important;
    transition-duration:.01ms!important;
    scroll-behavior:auto!important;
  }

  .reveal{
    opacity:1;
    filter:none;
    transform:none;
  }

}

</style>
</head>

<body>

<!-- ═══════════════════════════
     INTRO
═══════════════════════════ -->

<div id="intro"
     role="button"
     tabindex="0"
     onclick="enterSite()">

  <div class="intro-bg">

    <div
      class="intro-bg-item"
      style="background-image:url('https://github.com/jinkwf/jinkwf.github.io/blob/main/imgflll/Adobe%20Express%202026-07-24%2017.14.17.gif?raw=true')">
    </div>

    <div
      class="intro-bg-item"
      style="background-image:url('https://github.com/jinkwf/jinkwf.github.io/blob/main/imgflll/masterpiece,%20high%20quality,%20highly%20detailed,%20sharp%20focus,%20cinematic%20lighting,%20bea%20s-4222136508.png?raw=true')">
    </div>

    <div
      class="intro-bg-item"
      style="background-image:url('https://github.com/jinkwf/jinkwf.github.io/blob/main/imgflll/%EC%9C%A4%ED%83%9C%EC%9A%B0.png?raw=true')">
    </div>

  </div>

  <div class="intro-vignette"></div>
  <div class="intro-noise"></div>

  <div class="intro-content">

    <div class="intro-caption">
      PRIVATE RELATIONSHIP ARCHIVE
    </div>

    <h1 class="intro-title">
      나의 <span class="intro-x">X</span>
    </h1>

    <div class="intro-line"></div>

    <div class="intro-enter">
      CLICK TO ENTER
    </div>

  </div>

</div>


<!-- ═══════════════════════════
     MAIN
═══════════════════════════ -->

<main id="main">

<!-- NAV -->

<nav>

  <div class="nav-inner">

    <div class="logo">
      나의 <b>X</b>
    </div>

